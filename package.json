{
  "name": "tech-writer-prompts",
  "version": "1.0.0",
  "description": "An open-source, tested prompt library for technical writers.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": {
    "name": "Reem Sabawi",
    "url": "https://github.com/reem-sab"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reem-sab/tech-writer-prompts"
  },
  "bin": {
    "twp": "runner/dist/cli.js"
  },
  "files": [
